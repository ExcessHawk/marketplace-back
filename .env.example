# Copy to .env and fill in. Never commit .env.

PORT=3102

# Postgres from docker-compose.yml (host port 5442).
DATABASE_URL=postgresql://postgres:postgres@localhost:5442/marketplace

# A SEPARATE throwaway database. The test suite drops the public schema, so it
# refuses to reuse DATABASE_URL. Mark it once with `bun run db:mark-disposable`.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5442/marketplace_test

REDIS_URL=redis://localhost:6442

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=30d

# Comma-separated. 5102 is this project's frontend (PLANTILLA.md).
CORS_ORIGINS=http://localhost:5102,http://localhost:4173,http://localhost:4330

# Stripe Connect — test mode keys only in development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Platform commission in basis points. 1000 = 10%.
PLATFORM_COMMISSION_BPS=1000

LOG_LEVEL=debug
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=20

# Dónde caen las imágenes de producto. En el VPS es un volumen de Docker; en
# desarrollo, una carpeta del repo que .gitignore ya ignora.
UPLOADS_DIR=./data/uploads
PAYMENT_WEBHOOK_SECRET=cambia-esto-por-un-secreto-largo
PAYOUT_HOLD_DAYS=3

# Demo mode: hands out sessions without a password for the portfolio playground.
# NEVER turn this on against a database with real accounts.
DEMO_MODE=false

# La demostracion gasta una sesion por cada cambio de rol en el playground.
DEMO_RATE_LIMIT_MAX=40
