{
  "name": "marketplace-backend",
  "version": "0.1.0",
  "description": "Multi-vendor marketplace API on Veloce-TS",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:mark-disposable": "bun run src/db/mark-disposable.ts",
    "generate:openapi": "bun run node_modules/veloce-ts/bin/veloce.ts generate openapi",
    "admin:list": "bun run scripts/admin.ts list",
    "admin:grant": "bun run scripts/admin.ts grant",
    "admin:revoke": "bun run scripts/admin.ts revoke",
    "seed": "node scripts/seed.mjs",
    "demo:seed": "bun run scripts/demo-seed.mjs",
    "demo:reset": "bun run scripts/demo-reset.mjs",
    "demo:refresh": "bun run scripts/demo-reset.mjs && bun run scripts/demo-seed.mjs"
  },
  "dependencies": {
    "@marketplace/contracts": "github:ExcessHawk/marketplace-contracts",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.0",
    "veloce-ts": "^3.5.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}
